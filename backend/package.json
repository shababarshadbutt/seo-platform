{
  "name": "sitemap-migration-health-checker-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1095.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@json2csv/plainjs": "^7.0.6",
    "@types/archiver": "^8.0.0",
    "adm-zip": "^0.5.16",
    "archiver": "^8.0.0",
    "bullmq": "^5.12.12",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "piscina": "^5.3.0",
    "playwright-core": "^1.45.3",
    "sax": "^1.4.1",
    "ssh2-sftp-client": "^12.1.1",
    "undici": "^6.19.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/sax": "^1.2.7",
    "@types/ssh2-sftp-client": "^9.0.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
