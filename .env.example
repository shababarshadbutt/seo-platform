# Released version. Single source of truth: tags the frontend/backend/worker
# images AND is shown in the app navbar, so the UI always reports exactly what
# is deployed. Bump this one line per release (then build + push those tags).
APP_VERSION=v1.52

POSTGRES_USER=sitemap
POSTGRES_PASSWORD=sitemap
POSTGRES_DB=sitemap_health
DATABASE_URL=postgresql://sitemap:sitemap@postgres:5432/sitemap_health
REDIS_URL=redis://redis:6379
UPLOAD_DIR=/uploads
EXPORT_DIR=/exports
FRONTEND_URL=http://frontend:3000
PDF_BACKEND_URL=http://localhost:3001
CHROMIUM_PATH=/usr/bin/chromium-browser
# Secret used to encrypt GSC service-account credentials at rest (AES-256-GCM).
# Set a strong random value in production.
ENCRYPTION_KEY=dev-insecure-encryption-key-change-me
FRONTEND_PORT=3010
BACKEND_PORT=3011
# URL of the SEO Desk app (separate service) for the sitemap-tool navbar link.
NEXT_PUBLIC_SEO_DESK_URL=http://localhost:4000

# SEO Team Desk (apps/seo-desk) — Next.js + MongoDB, own NextAuth context.
SEO_DESK_PORT=4000
# NEXTAUTH_URL must match the host port SEO Desk is exposed on.
# NEXTAUTH_SECRET: set a strong random value in production (NextAuth crashes without it).
NEXTAUTH_SECRET=dev-insecure-nextauth-secret-change-me
CRON_SECRET=dev-insecure-cron-secret
POSTGRES_PORT=5432
REDIS_PORT=6380

# Set to "0" if behind a corporate SSL inspection proxy that uses self-signed
# (re-signed) certificates — otherwise all outbound URL sampling fails with
# "self-signed certificate in certificate chain" and every URL reports
# "No response". Applied to both the backend and worker services. Leave unset
# (or "1") on networks that do not intercept outbound TLS.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ---- Sitemap Cleaner --------------------------------------------------------
# Parallelism. Defaults are UNCHANGED from v1.49 on purpose — v1.50 measures the
# cleaner rather than tuning it. Sweep these to find the real bottleneck.
CLEANER_PARALLEL_THRESHOLD=200        # file count at/above which the worker pools engage
CLEANER_MAX_WORKERS=4                 # piscina threads per cleaner pool (1-16)

# Run lifecycle. A cleaner run lives in the API process, not in a queue.
CLEANER_ABANDON_GRACE_MINUTES=5       # unwatched run is aborted after this
CLEANER_PENDING_UPLOAD_TIMEOUT_SECONDS=120
CLEANER_REQUEST_TIMEOUT_MINUTES=30
CLEANER_RUN_MAX_AGE_HOURS=6           # age-based sweep of <UPLOAD_DIR>/cleaner/<runId>

# Log volume. A default run emits ONE "cleaner run timing" line plus a bounded
# heartbeat and nothing per-file. Only turn the trace on to diagnose a slow run:
# it costs ~2 debug lines per file (so ~3,400 for a 1,700-file upload).
CLEANER_TRACE=0                       # 1 = per-file timing at debug level
CLEANER_HEARTBEAT_SECONDS=30          # 0 disables the in-run progress heartbeat

# Batched upload (v1.51). The browser cannot assemble a 1,681-part multipart
# body in reasonable time, so files go up in small batches instead. The batch
# size is SERVER-chosen and returned by create-run: client and server disagreeing
# about it would silently mis-order files, and file order decides which
# duplicate URL is kept.
# V8 heap ceiling for the BACKEND container, in MB. The cleaner's dedup map is
# ~130 bytes per unique URL, so this is what bounds the largest corpus that can
# be cleaned in one run. Raise it if a run dies with "Reached heap limit"; the
# host needs to have the RAM free.
BACKEND_HEAP_MB=12288

CLEANER_UPLOAD_BATCH_SIZE=50          # files per upload request (1-500)
CLEANER_MAX_FILES_PER_RUN=20000       # ceiling on one run's declared total
