# Released version. Single source of truth: tags the frontend/backend/worker
# images AND is shown in the app navbar, so the UI always reports exactly what
# is deployed. Bump this one line per release (then build + push those tags).
APP_VERSION=v1.47

POSTGRES_USER=sitemap
POSTGRES_PASSWORD=sitemap
POSTGRES_DB=sitemap_health
DATABASE_URL=postgresql://sitemap:sitemap@postgres:5432/sitemap_health
REDIS_URL=redis://redis:6379
UPLOAD_DIR=/uploads
EXPORT_DIR=/exports
FRONTEND_URL=http://frontend:3000
PDF_BACKEND_URL=http://localhost:3001
CHROMIUM_PATH=/usr/bin/chromium-browser
# Secret used to encrypt GSC service-account credentials at rest (AES-256-GCM).
# Set a strong random value in production.
ENCRYPTION_KEY=dev-insecure-encryption-key-change-me
FRONTEND_PORT=3010
BACKEND_PORT=3011
# URL of the SEO Desk app (separate service) for the sitemap-tool navbar link.
NEXT_PUBLIC_SEO_DESK_URL=http://localhost:4000

# SEO Team Desk (apps/seo-desk) — Next.js + MongoDB, own NextAuth context.
SEO_DESK_PORT=4000
# NEXTAUTH_URL must match the host port SEO Desk is exposed on.
# NEXTAUTH_SECRET: set a strong random value in production (NextAuth crashes without it).
NEXTAUTH_SECRET=dev-insecure-nextauth-secret-change-me
CRON_SECRET=dev-insecure-cron-secret
POSTGRES_PORT=5432
REDIS_PORT=6380

# Set to "0" if behind a corporate SSL inspection proxy that uses self-signed
# (re-signed) certificates — otherwise all outbound URL sampling fails with
# "self-signed certificate in certificate chain" and every URL reports
# "No response". Applied to both the backend and worker services. Leave unset
# (or "1") on networks that do not intercept outbound TLS.
NODE_TLS_REJECT_UNAUTHORIZED=0

# How long after a session completes its uploaded sitemap files are deleted, as a
# SAFETY NET for abandoned sessions. Was a hardcoded 1 hour and the primary
# cleanup path; the deliberate path is now the post-publish prompt and the
# History storage view, which ask before deleting. Raise it if reviewers need
# longer with large client sites; lower it if the uploads volume runs tight.
# Clamped to 1..720 hours.
UPLOAD_CLEANUP_DELAY_HOURS=48

# How many SFTP transfers run at once, for both the Cleaner's SFTP source and the
# Migration SFTP pull. Every download is its own SSH connect + transfer + close,
# so this is the single biggest lever on a large pull: measured on 2,264 files,
# raising it from 1 to 4 cut the pull stage from 34.6 min to 7.0 min and the whole
# Cleaner run from 35.9 min to 8.4 min. Bounded because the VM and the Transfer
# Family endpoint are shared by 10+ users; clamped to 1..32.
SFTP_MAX_CONCURRENT_CONNECTIONS=4

# V8 heap ceiling (MiB) for the BACKEND container only, used by
# docker-compose.aws.yml. The default 12288 is derived from a 32 GB host with
# Postgres/Mongo/Redis/two Next apps/the worker alongside it — see the arithmetic
# in that file before changing it, and do NOT push it toward the host's total:
# --max-old-space-size governs only the main-thread heap, while the Cleaner's 4
# piscina worker threads and all off-heap Buffer/zlib/ssh2 memory sit outside it.
#
# There is deliberately NO companion "max unique URLs" setting. The Cleaner's
# dedup ceiling is computed from the live heap limit at runtime
# (backend/src/sitemaps/dedupBudget.ts), so changing this one number moves the
# guard with it. Two hand-maintained numbers would drift, and the failure mode of
# that drift is the silent heap abort the guard exists to prevent.
BACKEND_HEAP_MB=12288

# How long a Cleaner run with nobody watching keeps going before it is stopped and
# its SFTP connection slots released. A dropped browser connection no longer kills
# a run (the client can reconnect to it), so this is the bound that stops a
# forgotten run holding a shared slot for its whole duration — which measurably
# halved throughput for other users. Clamped to 1..120 minutes.
CLEANER_ABANDON_GRACE_MINUTES=5

# Ceiling on a SINGLE SFTP operation — the connect, one file transfer, or the
# directory listing — each of which holds one of the connection slots above for
# its duration. Exists because there was no bound at all: two wedged transfers
# left the pool at 0 of 2 for minutes and blocked every other user.
#
# Worth raising for a client whose sitemap directory is very large, because the
# LISTING is one operation: a directory that takes longer than this to enumerate
# fails the run before the first file is pulled, and the error names an SFTP
# timeout rather than the directory size. Clamped to 10..3600 seconds.
SFTP_OPERATION_TIMEOUT_SECONDS=120
